+++ b/packages/scripts/src/utils/cx-work-gate.ts
@@ -0,0 +1,243 @@
+/**
+ * [cxstudy M14] 作业/考试手动触发闸门 + 预检 + 责任声明。
+ *
+ * 用户明确要求（本文件就是它的实现）：
+ *   - 绝不在进入作业/考试页面时自动作答；
+ *   - 必须由用户在看到预检报告后手动点「开始作答」；
+ *   - 功能默认关闭；需先勾选责任声明；考试另需单独授权；
+ *   - 使用本功能的风险由用户自行承担（面板与弹窗都要写明）。
+ *
+ * 与上游的差异：上游两条路径都是「倒计时自动开始 + 可取消」
+ *   - 非 iframe：`workPreCheckMessage()` → `将在 N 秒后自动答题，点击取消`
+ *   - 子 iframe：`commonWork()` 里直接 `$message.info('将在 N 秒后自动答题')` + setTimeout
+ * 本模块把两者统一改成「显式确认后才开始」，即 opt-in 而非 opt-out。
+ *
+ * 【不会因为用户授权而放行的两项】
+ *   人脸识别、人机验证码 —— 出现即停手，交由人工完成。这是硬边界。
+ */
+
+const FACE_SELECTORS = ['#fcqrimg', '.chapterVideoFaceMaskDiv'];
+
+/** 验证码特征（与 cx.ts 的 detectCaptcha 保持同一套判据；故意不含通用的 .slider，实测会误报课表组件） */
+const CAPTCHA_HINTS: Array<[string, string]> = [
+	['img[src*="captcha"]', 'captcha 图片'],
+	['img[src*="validate"]', 'validate 图片'],
+	['#yzmImg, .yzmImg, .yzm, .picCode, .refresh-code', '图形验证码（超星常用类名）'],
+	['#verifyCode, #validateCode, #captcha', '验证码元素 id'],
+	['input[name="validateCode"], input[name="verifyCode"], input[name="captcha"]', '验证码输入框'],
+	['.verifyimg, .validateCode, .captcha', '验证码容器类名'],
+	['.geetest_panel, .nc-container, .verify-slider, .slide-verify, .nc_scale', '滑块验证组件']
+];
+
+/** 跨 iframe 深度查询（同源才可访问，跨域静默跳过） */
+function queryAllDeep(selector: string): HTMLElement[] {
+	const out: HTMLElement[] = [];
+	const seen = new Set<Document>();
+	const walk = (doc: Document) => {
+		if (!doc || seen.has(doc)) return;
+		seen.add(doc);
+		try {
+			out.push(...Array.from(doc.querySelectorAll<HTMLElement>(selector)));
+		} catch (e) {
+			/* 忽略 */
+		}
+		try {
+			Array.from(doc.querySelectorAll('iframe')).forEach((f) => {
+				try {
+					if (f.contentWindow && f.contentWindow.document) walk(f.contentWindow.document);
+				} catch (e) {
+					/* 跨域，忽略 */
+				}
+			});
+		} catch (e) {
+			/* 忽略 */
+		}
+	};
+	walk(document);
+	return out;
+}
+
+/** 当前页面是否是考试 */
+export function isExamPage() {
+	return /\/exam\/(preview|test)/.test(location.href);
+}
+
+export interface CxWorkPreCheckResult {
+	ok: boolean;
+	lines: string[];
+	questionCount: number;
+	hasFace: boolean;
+	hasCaptcha: boolean;
+}
+
+/**
+ * 预检：回答“当前界面是否有题目、是否可以进行答题”。
+ * 只读，不点击任何按钮。
+ */
+export function cxWorkPreCheck(): CxWorkPreCheckResult {
+	const lines: string[] = [];
+	let ok = true;
+	const good = (s: string) => lines.push('✅ ' + s);
+	const bad = (s: string) => {
+		lines.push('❌ ' + s);
+		ok = false;
+	};
+	const info = (s: string) => lines.push('ℹ️ ' + s);
+
+	// 1) 题目
+	const questionLi = queryAllDeep('.questionLi');
+	const tiMu = queryAllDeep('.TiMu');
+	const questionCount = questionLi.length || tiMu.length;
+	if (questionCount > 0) {
+		good(
+			'检测到题目 ' +
+				questionCount +
+				' 道' +
+				(questionLi.length ? '（.questionLi，作业/考试）' : '（.TiMu，章节测验）')
+		);
+	} else {
+		bad('未检测到题目容器（.questionLi / .TiMu）—— 可能尚未进入答题界面');
+	}
+
+	// 2) 已提交 / 已完成
+	if (queryAllDeep('.testTit_status_complete').length > 0) {
+		bad('页面标记为已完成（testTit_status_complete），没有可作答的题');
+	}
+
+	// 3) 硬边界：人脸识别
+	const hasFace = FACE_SELECTORS.some((sel) => queryAllDeep(sel).length > 0);
+	if (hasFace) bad('检测到人脸识别：脚本不会绕过，必须先人工完成识别');
+
+	// 4) 硬边界：人机验证
+	let hasCaptcha = false;
+	let captchaBy = '';
+	for (const [sel, by] of CAPTCHA_HINTS) {
+		if (queryAllDeep(sel).length > 0) {
+			hasCaptcha = true;
+			captchaBy = by;
+			break;
+		}
+	}
+	if (!hasCaptcha) {
+		try {
+			const txt = (document.body && document.body.innerText) || '';
+			for (const w of ['请输入验证码', '人机验证', '拖动滑块', '完成验证', '验证码校验']) {
+				if (txt.indexOf(w) >= 0) {
+					hasCaptcha = true;
+					captchaBy = '文案「' + w + '」';
+					break;
+				}
+			}
+		} catch (e) {
+			/* 忽略 */
+		}
+	}
+	if (hasCaptcha) bad('检测到人机验证（' + captchaBy + '）：脚本不会识别或绕过');
+
+	// 5) 考试前置页提示（仅提示，不判定为阻断 —— 这些页面的 DOM 无法可靠识别）
+	if (isExamPage()) {
+		try {
+			const txt = (document.body && document.body.innerText) || '';
+			['考生承诺', '诚信考试', '考试承诺书', '重考须知', '等待开始', '开考时间'].forEach((w) => {
+				if (txt.indexOf(w) >= 0) info('页面文本含「' + w + '」，请确认你已经真正进入答题界面');
+			});
+		} catch (e) {
+			/* 忽略 */
+		}
+	}
+
+	// 6) 图片题提示（帮助用户决定要不要开「允许图片题」）
+	try {
+		const imgs = queryAllDeep('.questionLi img, .TiMu img');
+		if (imgs.length > 0) {
+			info('检测到题目图片 ' + imgs.length + ' 张；若正确率不理想，可开启「允许图片题」与「截图兜底」');
+		}
+	} catch (e) {
+		/* 忽略 */
+	}
+
+	return { ok, lines, questionCount, hasFace, hasCaptcha };
+}
+
+/**
+ * 闸门：只有用户确认后才调用 onStart。
+ *
+ * @param cfg         全局设置对象（由调用方传入，避免本模块反向依赖 common.ts 造成新的循环引用）
+ * @param onStart     真正开始作答的回调
+ * @param interactive 当前是否可用交互弹窗（子 iframe 跨窗口场景为 false）
+ * @param deps        必要的 UI 依赖（由调用方注入，保持本模块不直接依赖 easy-us）
+ */
+export function cxWorkGate(opts: {
+	cfg: any;
+	onStart: () => void;
+	interactive: boolean;
+	deps: {
+		log: (msg: string) => void;
+		warn: (msg: string, duration?: number) => void;
+		confirm: (o: { content: any; confirmButtonText: string; cancelButtonText: string; onConfirm: () => void }) => void;
+		notes: (lines: any[]) => any;
+	};
+}) {
+	const cfg = opts.cfg || {};
+	const { log, warn, confirm, notes } = opts.deps;
+	const isExam = isExamPage();
+	const typeName = isExam ? '考试' : '作业';
+
+	// ---- 授权链：默认关闭 → 责任声明 → 考试单独授权 ----
+	if (!cfg.cxWorkEnabled) {
+		log('[cxstudy M14] ' + typeName + '自动作答未启用（默认关闭）→ 不启动。');
+		warn('作业/考试自动作答默认关闭。如确有需要，请在「通用-全局设置」开启并确认责任声明。', 10);
+		return;
+	}
+	if (!cfg.cxWorkConsent) {
+		log('[cxstudy M14] 未确认责任声明 → 拒绝启动。');
+		warn('请先在「通用-全局设置」勾选责任声明，才可使用作业/考试自动作答。', 10);
+		return;
+	}
+	if (isExam && !cfg.cxExamEnabled) {
+		log('[cxstudy M14] 考试需单独授权 → 拒绝启动。');
+		warn('考试需单独授权：请在「通用-全局设置」勾选「考试单独授权」。', 10);
+		return;
+	}
+
+	// ---- 预检 ----
+	const pre = cxWorkPreCheck();
+	log('[cxstudy M14] 预检结果（' + typeName + '）：\n' + pre.lines.join('\n'));
+
+	// ---- 硬边界：授权也不放行 ----
+	if (pre.hasFace) {
+		log('[cxstudy M14] 检测到人脸识别 → 停手，等人工完成。');
+		warn('检测到人脸识别：脚本不会绕过，请人工完成后再手动开始。', 0);
+		return;
+	}
+	if (pre.hasCaptcha) {
+		log('[cxstudy M14] 检测到人机验证 → 停手。');
+		warn('检测到人机验证：脚本不会识别或绕过，请人工通过后再手动开始。', 0);
+		return;
+	}
+
+	// ---- 子 iframe：交互弹窗不可用，只能让用户去点面板 ----
+	if (!opts.interactive) {
+		log('[cxstudy M14] 子 iframe 场景弹窗回调不可用 → 需你手动点击面板的开始按钮。');
+		warn('子窗口场景无法弹确认框：请在脚本面板中手动点击开始。', 15);
+		return;
+	}
+
+	// ---- 显式确认 ----
+	confirm({
+		content: notes([
+			'【' + typeName + '】预检结果：',
+			...pre.lines,
+			'',
+			'⚠️ 风险提示：使用本功能的风险（含成绩与学术诚信后果）由你自己承担。',
+			'本脚本不会绕过人脸识别与人机验证码 —— 出现时必须由你人工完成。',
+			pre.ok ? '预检未发现阻断项。' : '预检发现异常项，建议不要开始。'
+		]),
+		cancelButtonText: '取消（推荐）',
+		confirmButtonText: pre.ok ? '开始作答' : '我确认，仍然开始',
+		onConfirm() {
+			log('[cxstudy M14] 用户已确认，开始作答。');
+			opts.onStart();
+		}
+	});
+}
