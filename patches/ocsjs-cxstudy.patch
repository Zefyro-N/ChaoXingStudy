+ *
+ * OCS 允许 `data` 的每个字段是一个 `{ handler: '<字符串>' }`，该字符串会被
+ * `Function(...)()` 求值成函数并以 `env`（题目上下文）为参数调用。
+ * 因此下面必须以**字符串**形式书写，内部换行写成 \\n（模板字符串转义）。
+ *
+ * @param debug 打开后会把实际发出的 prompt 打到控制台，便于核对选项是否带上
+ */
+function makeMessagesHandler(debug: boolean): string {
+	return `return function (env) {
+	var DEBUG = ${debug ? 'true' : 'false'};
+	var kindMap = { single: '单选题', multiple: '多选题', judgement: '判断题', completion: '填空题', line: '连线题', fill: '选词填空题', reader: '阅读理解题' };
+	var kind = kindMap[env.type] || '题目';
+	var letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
+	var lines = String(env.options || '').split('\\n').map(function (s) { return s.trim(); }).filter(Boolean);
+	var isChoice = env.type === 'single' || env.type === 'multiple' || env.type === 'judgement';
+	if (isChoice && lines.length === 0) {
+		console.warn('[cxstudy M2] ⚠️ 选择题未取到任何选项，本题必然答错。题型=' + env.type + '，题干=' + String(env.title || '').slice(0, 60));
+	}
+	var body = lines.length
+		? '题干：' + env.title + '\\n选项：\\n' + lines.map(function (t, i) { return letters.charAt(i) + '. ' + t; }).join('\\n')
+		: '题干：' + env.title;
+	var msgs = [
+		{ role: 'system', content: ${JSON.stringify(SYSTEM_PROMPT)} },
+		{ role: 'user', content: '题型：' + kind + '\\n' + body + '\\n\\n答案：' }
+	];
+	if (DEBUG) { console.log('[cxstudy M2] 发送给模型的 prompt:', JSON.stringify(msgs, null, 2)); }
+	return msgs;
+};`;
+}
+
+/**
+ * 生成响应处理器源码。返回 `[题目, 答案]` 二元组（上游要求）。
+ *
+ * 题目字段留空：上游只有 `results[].answer` 参与 resolver 匹配，
+ * `question` 仅用于结果面板展示。
+ *
+ * 兼容思考模型：`content` 为空时（max_tokens 被 reasoning 烧光）从
+ * `reasoning_content` 尾部用正则兜底 —— 从 E:\Code\Estudy 的 askModel() 复刻。
+ */
+function makeResponseHandler(debug: boolean): string {
+	return `return function (res) {
+	var DEBUG = ${debug ? 'true' : 'false'};
+	if (DEBUG) { console.log('[cxstudy M2] 模型原始响应:', JSON.stringify(res)); }
+	var ch = (res && res.choices && res.choices[0]) || {};
+	var msg = ch.message || {};
+	var text = String(msg.content || '').trim();
+	if (!text) {
+		var rs = String(msg.reasoning_content || '');
+		var cand = rs.slice(-500).toUpperCase().match(/\\b([A-F])\\b/g);
+		text = cand && cand.length ? cand[cand.length - 1] : '';
+	}
+	if (DEBUG) { console.log('[cxstudy M2] 解析出的答案:', JSON.stringify(text)); }
+	return ['', text];
+};`;
+}
+
+/**
+ * 构建本项目的模型答题器。
+ *
+ * @param provider 提供商 id，只接受 CX_PROVIDERS 的键，其他值一律回退到 opencode-go
+ * @param apiKey   模型 API Key；为空时返回空数组（此时不会发出任何请求）
+ * @param debug    打开后把 prompt 与原始响应打到控制台
+ */
+export function buildModelAnswererWrappers(
+	provider: string,
+	apiKey: string,
+	debug = false
+): AnswererWrapper[] {
+	const key = String(apiKey || '').trim();
+	if (!key) return [];
+
+	// 不存在的提供商一律回退，避免任意 URL 被注入
+	const p = CX_PROVIDERS[provider] || CX_PROVIDERS['opencode-go'];
+
+	return [
+		{
+			name: p.label + ' / ' + CX_LOCKED_MODEL,
+			homepage: p.url,
+			url: p.url,
+			method: 'post',
+			type: 'GM_xmlhttpRequest',
+			responseType: 'json',
+			headers: Object.assign(
+				{
+					Authorization: 'Bearer ' + key,
+					'Content-Type': 'application/json'
+				},
+				p.extraHeaders
+			) as Record<string, string>,
+			data: {
+				model: CX_LOCKED_MODEL,
+				messages: { handler: makeMessagesHandler(debug) },
+				max_tokens: 4096,
+				temperature: 0,
+				stream: false
+			},
+			handler: makeResponseHandler(debug)
+		} as unknown as AnswererWrapper
+	];
+}
+
+/** 是否已配置可用的模型答题器 */
+export function hasModelConfigured(provider: string, apiKey: string): boolean {
+	return buildModelAnswererWrappers(provider, apiKey).length > 0;
+}
