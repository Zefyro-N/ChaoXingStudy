+/**
+ * [cxstudy M2/M12] 本项目锁定的模型答题器。
+ *
+ * 设计约束（来自用户要求，不允许放宽）：
+ *   1. 只允许两个提供商：opencode-go、deepseek 官方
+ *   2. 模型严格锁定为 deepseek-v4.1-flash，界面不提供其他模型的入口
+ *   3. API Key 只存在本地脚本存储中，不写入任何项目文件
+ *
+ * 实现方式：把模型包装成 OCS 原生的 `AnswererWrapper`（通用 HTTP 答题器），
+ * 从而直接复用上游完整的题型 resolver（单选/多选/判断/填空），不重写答题框架。
+ *
+ * 答案格式必须对齐上游 resolver 的匹配阶段（本文件最关键的设计点）：
+ *   - 单选/多选：要求模型返回**选项原文**，命中 `resolveSingle`/`resolveMultiple`
+ *     的阶段 1「归一化精确匹配」。阶段 3 有纯 ABCD 兜底，所以万一回了字母也能用。
+ *   - 判断：必须返回**极性词「正确」/「错误」**。`resolveJudgement` 只认
+ *     CORRECT_WORDS/INCORRECT_WORDS 里的词，返回字母一定失败。
+ *   - 填空：返回答案文本。
+ *
+ * [M12] 图片题：消费上游已经准备好的 `env.images`（data URL 数组，顺序对应
+ * `env.suggestion_title` / `env.suggestion_options` 里的 `[图片N]` 占位符），
+ * 把 user 消息的 `content` 从字符串改成块数组（text + image_url）。
+ * 因为本文件的数据解析器引用了 `env.images`，上游的
+ * `isAnswererWrappersSupportImageOptimize()` 会自动判定"该配置支持图片题"。
+ */
+import type { AnswererWrapper } from '@ocsjs/core';
+
+/** 锁定的模型：不提供修改入口。V4.1 Flash 原生支持多模态 */
+export const CX_LOCKED_MODEL = 'deepseek-v4.1-flash';
+
+/** 只允许这两个提供商 */
+export const CX_PROVIDERS: Record<
+	string,
+	{ label: string; url: string; extraHeaders: Record<string, string> }
+> = {
+	'opencode-go': {
+		label: 'opencode-go',
+		url: 'https://opencode.ai/inference/go/v1/chat/completions',
+		extraHeaders: {
+			// OpenCode Go 要求自定义 UA + 稳定会话 ID
+			// ${__session} 由 answer.wrapper.handler.ts 的 [cxstudy M2] 补丁注入
+			'User-Agent': 'ocs-cxstudy/1.0',
+			'x-opencode-session': '${__session}'
+		}
+	},
+	deepseek: {
+		label: 'deepseek 官方',
+		url: 'https://api.deepseek.com/chat/completions',
+		extraHeaders: {}
+	}
+};
+
+/**
+ * 系统提示词：让模型认清角色，直接给答案。
+ *
+ * 第 1 条与第 6 条是效率的关键——禁止输出推理过程与疑问，
+ * 避免思考模型把 max_tokens 烧在解释上（那会直接导致 content 为空）。
+ */
+const SYSTEM_PROMPT = [
+	'你是一个只负责给出答案的答题助手，服务对象是参加在线课程测验的学生。',
+	'严格遵守以下规则：',
+	'1. 只输出最终答案本身，不要输出解释、推理过程、题号、引号或其他任何前后缀。',
+	'2. 单选题：输出正确选项的完整文字。',
+	'3. 多选题：输出所有正确选项的完整文字，用英文逗号分隔，不要输出字母。',
+	'4. 判断题：只输出「正确」或「错误」两个词中的一个。',
+	'5. 填空题：只输出答案文本。',
+	'6. 不确定时给出你认为最可能的一个答案，不要提问、不要要求补充信息、不要拒绝作答。',
+	'7. 题干或选项附带图片时，图片会用 [图片N] 标注位置并按顺序附在消息末尾，请结合图片内容作答。'
+].join('\n');
+
+/**
+ * 生成 `data.messages` 的字段解析器源码。
+ *
+ * OCS 允许 `data` 的每个字段是一个 `{ handler: '<字符串>' }`，该字符串会被
+ * `Function(...)()` 求值成函数并以 `env`（题目上下文）为参数调用。
+ * 因此下面必须以**字符串**形式书写，内部换行写成 \\n（模板字符串转义）。
+ *
+ * @param debug  打开后会把实际发出的 prompt 打到控制台（base64 已截断，避免刷爆控制台）
+ * @param vision 打开后把 `env.images` 作为 image_url 内容块一并发送
+ */
+function makeMessagesHandler(debug: boolean, vision: boolean): string {
+	return `return function (env) {
+	var DEBUG = ${debug ? 'true' : 'false'};
+	var VISION = ${vision ? 'true' : 'false'};
+	var kindMap = { single: '单选题', multiple: '多选题', judgement: '判断题', completion: '填空题', line: '连线题', fill: '选词填空题', reader: '阅读理解题' };
+	var kind = kindMap[env.type] || '题目';
+	var letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
+	var images = (VISION && env.images && env.images.length) ? env.images : [];
+	// 有图片时优先用带 [图片N] 占位符的文本，模型才知道图片对应题干还是某个选项
+	var rawTitle = (images.length && env.suggestion_title) ? env.suggestion_title : (env.title || '');
+	var rawOptions = (images.length && env.suggestion_options) ? env.suggestion_options : (env.options || '');
+	var lines = String(rawOptions).split('\\n').map(function (s) { return s.trim(); }).filter(Boolean);
+	var isChoice = env.type === 'single' || env.type === 'multiple' || env.type === 'judgement';
+	if (isChoice && lines.length === 0) {
+		console.warn('[cxstudy M2] 选择题未取到任何选项，本题必然答错。题型=' + env.type + '，题干=' + String(rawTitle).slice(0, 60));
+	}
+	var body = lines.length
+		? '题干：' + rawTitle + '\\n选项：\\n' + lines.map(function (t, i) { return letters.charAt(i) + '. ' + t; }).join('\\n')
+		: '题干：' + rawTitle;
+	if (images.length) {
+		body += '\\n\\n本题附带 ' + images.length + ' 张图片' + (shot ? '（最后一张是题目区域的整图截图）' : '（按 [图片N] 顺序附后）') + '。';
+	}
+	var userText = '题型：' + kind + '\\n' + body + '\\n\\n答案：';
+	var content;
+	if (images.length) {
+		content = [{ type: 'text', text: userText }];
+		for (var i = 0; i < images.length; i++) {
+			content.push({ type: 'image_url', image_url: { url: images[i] } });
+		}
+	} else {
+		content = userText;
+	}
+	var msgs = [
+		{ role: 'system', content: ${JSON.stringify(SYSTEM_PROMPT)} },
+		{ role: 'user', content: content }
+	];
+	if (DEBUG) {
+		// base64 图片会非常大，截断后再打印
+		console.log('[cxstudy M2] 发送给模型的 prompt(前2000字符):', JSON.stringify(msgs).slice(0, 2000));
+	}
+	return msgs;
+};`;
+}
+
+/**
+ * 生成响应处理器源码。返回 `[题目, 答案]` 二元组（上游要求）。
+ *
+ * 题目字段留空：上游只有 `results[].answer` 参与 resolver 匹配，
+ * `question` 仅用于结果面板展示。
+ *
+ * 兼容思考模型：`content` 为空时（max_tokens 被 reasoning 烧光）从
+ * `reasoning_content` 尾部用正则兜底 —— 从 E:\Code\Estudy 的 askModel() 复刻。
+ */
+function makeResponseHandler(debug: boolean): string {
+	return `return function (res) {
+	var DEBUG = ${debug ? 'true' : 'false'};
+	if (DEBUG) { console.log('[cxstudy M2] 模型原始响应:', JSON.stringify(res).slice(0, 2000)); }
+	var ch = (res && res.choices && res.choices[0]) || {};
+	var msg = ch.message || {};
+	var text = String(msg.content || '').trim();
+	if (!text) {
+		var rs = String(msg.reasoning_content || '');
+		var cand = rs.slice(-500).toUpperCase().match(/\\b([A-F])\\b/g);
+		text = cand && cand.length ? cand[cand.length - 1] : '';
+	}
+	if (DEBUG) { console.log('[cxstudy M2] 解析出的答案:', JSON.stringify(text)); }
+	return ['', text];
+};`;
+}
+
+/**
+ * 构建本项目的模型答题器。
+ *
+ * @param provider 提供商 id，只接受 CX_PROVIDERS 的键，其他值一律回退到 opencode-go
+ * @param apiKey   模型 API Key；为空时返回空数组（此时不会发出任何请求）
+ * @param debug    打开后把 prompt 与原始响应打到控制台
+ * @param vision   [M12] 打开后把题目图片作为多模态内容块发给模型
+ */
+export function buildModelAnswererWrappers(
+	provider: string,
+	apiKey: string,
+	debug = false,
+	vision = false
+): AnswererWrapper[] {
+	const key = String(apiKey || '').trim();
+	if (!key) return [];
+
+	// 不存在的提供商一律回退，避免任意 URL 被注入
+	const p = CX_PROVIDERS[provider] || CX_PROVIDERS['opencode-go'];
+
+	return [
+		{
+			name: p.label + ' / ' + CX_LOCKED_MODEL + (vision ? ' / 图片题' : ''),
+			homepage: p.url,
+			url: p.url,
+			method: 'post',
+			type: 'GM_xmlhttpRequest',
+			responseType: 'json',
+			headers: Object.assign(
+				{
+					Authorization: 'Bearer ' + key,
+					'Content-Type': 'application/json'
+				},
+				p.extraHeaders
+			) as Record<string, string>,
+			data: {
+				model: CX_LOCKED_MODEL,
+				messages: { handler: makeMessagesHandler(debug, vision) },
+				max_tokens: 4096,
+				temperature: 0,
+				stream: false
+			},
+			handler: makeResponseHandler(debug)
+		} as unknown as AnswererWrapper
+	];
+}
+
+/** 是否已配置可用的模型答题器 */
+export function hasModelConfigured(provider: string, apiKey: string): boolean {
+	return buildModelAnswererWrappers(provider, apiKey).length > 0;
+}
diff --git a/packages/scripts/src/utils/cx-screenshot.ts b/packages/scripts/src/utils/cx-screenshot.ts
new file mode 100644
index 0000000..2907d60
--- /dev/null
+++ b/packages/scripts/src/utils/cx-screenshot.ts
@@ -0,0 +1,194 @@
+/**
+ * [cxstudy M13] 截图兜底：把题目区域渲染成图片，交给支持识图的模型。
+ *
+ * 为什么需要它（上游的 env.images 覆盖不到的场景）：
+ *   1. 题面内容不是 <img>，而是 canvas / CSS background / 伪元素渲染的 —— 没有 URL 可抓
+ *   2. 上游抓到了 <img> 但转 base64 失败（跨域 / 防盗链），图片被整体丢弃
+ *   3. 题干文本被 `font-cxsecret` 等混淆字体保护（渲染正确、文本错乱）
+ *
+ * 实现方式：零新依赖 —— 克隆节点 → 把 <img> 的 src 换成已抓到的 data URL
+ * （避免 canvas 被跨域图片污染）→ 内联关键样式 → SVG foreignObject → canvas → dataURL。
+ *
+ * 【已知限制，必须如实告知，不要当成万能方案】
+ *   1. SVG 渲染器**不会加载页面的自定义字体**。所以对「混淆字体」这个场景，
+ *      纯 foreignObject 截图**渲染出来的仍然是回退字体的乱码**，除非把混淆字体本身
+ *      以 base64 @font-face 内嵌进 SVG。上游已有取字体字节的能力
+ *      （font-decrypt 的 `extractFontFromStyle`），但内嵌字体尚未实现。
+ *   2. 内联样式是**白名单近似**，复杂布局（绝对定位、浮层、表格）可能不如原页面。
+ *   3. 若克隆结果里仍残留跨域资源，`toDataURL()` 会抛 SecurityError，函数返回 undefined，
+ *      调用方必须按「没有截图」降级处理。
+ *   4. 图片会显著增加请求体积与 token。因此只在「文本路径明显不够用」时才截图，
+ *      不做无条件截图。
+ */
+
+/** 需要内联的样式白名单（覆盖题目排版的常见需求，故意不求全） */
+const STYLE_KEYS = [
+	'display',
+	'position',
+	'overflow',
+	'box-sizing',
+	'width',
+	'height',
+	'min-width',
+	'max-width',
+	'margin',
+	'padding',
+	'border-top-width',
+	'border-right-width',
+	'border-bottom-width',
+	'border-left-width',
+	'border-style',
+	'border-color',
+	'border-radius',
+	'background-color',
+	'background-image',
+	'background-size',
+	'background-position',
+	'background-repeat',
+	'color',
+	'font-family',
+	'font-size',
+	'font-style',
+	'font-weight',
+	'line-height',
+	'letter-spacing',
+	'text-align',
+	'text-decoration',
+	'text-indent',
+	'vertical-align',
+	'white-space',
+	'word-break',
+	'list-style-type',
+	'list-style-position',
+	'flex-direction',
+	'flex-wrap',
+	'justify-content',
+	'align-items',
+	'gap',
+	'grid-template-columns'
+] as const;
+
+/** 递归把源节点的计算样式内联到克隆节点 */
+function inlineStyles(src: Element, dst: Element) {
+	let cs: CSSStyleDeclaration;
+	try {
+		cs = getComputedStyle(src);
+	} catch (e) {
+		return;
+	}
+	const style = (dst as HTMLElement).style;
+	if (style) {
+		for (const k of STYLE_KEYS) {
+			const v = cs.getPropertyValue(k);
+			if (v && v !== 'none' && v !== 'normal' && v !== 'auto') {
+				try {
+					style.setProperty(k, v);
+				} catch (e) {
+					/* 个别属性非法值，忽略 */
+				}
+			} else if (v) {
+				try {
+					style.setProperty(k, v);
+				} catch (e) {
+					/* 忽略 */
+				}
+			}
+		}
+	}
+	const sChildren = src.children;
+	const dChildren = dst.children;
+	const n = Math.min(sChildren.length, dChildren.length);
+	for (let i = 0; i < n; i++) {
+		inlineStyles(sChildren[i], dChildren[i]);
+	}
+}
+
+/**
+ * 把元素渲染为 PNG data URL。
+ *
+ * @param el     题目根元素（章节测验的 `.TiMu`、作业/考试的 `.questionLi`）
+ * @param toDataUrl 上游的图片转 base64 函数，用于把 <img> 换成 data URL
+ * @param maxWidth  宽度上限，超过则等比缩小（控制体积）
+ */
+export async function captureElementAsDataUrl(
+	el: HTMLElement,
+	toDataUrl: (source: string | HTMLImageElement) => Promise<string>,
+	maxWidth = 900
+): Promise<string | undefined> {
+	try {
+		const w0 = el.offsetWidth || el.clientWidth;
+		const h0 = el.offsetHeight || el.clientHeight;
+		if (!w0 || !h0) return undefined;
+
+		const scale = w0 > maxWidth ? maxWidth / w0 : 1;
+		const w = Math.round(w0 * scale);
+		const h = Math.round(h0 * scale);
+		if (w < 8 || h < 8) return undefined;
+
+		const clone = el.cloneNode(true) as HTMLElement;
+
+		// 1) 把 <img> 的 src 换成 data URL —— 关键步骤：
+		//    否则 SVG 里的跨域图片会让 canvas 被污染，toDataURL() 直接抛 SecurityError
+		const srcImgs = Array.from(el.querySelectorAll('img'));
+		const dstImgs = Array.from(clone.querySelectorAll('img'));
+		for (let i = 0; i < Math.min(srcImgs.length, dstImgs.length); i++) {
+			try {
+				const dataUrl = await toDataUrl(srcImgs[i]);
+				if (dataUrl && dataUrl.indexOf('data:') === 0) {
+					dstImgs[i].setAttribute('src', dataUrl);
+				} else {
+					dstImgs[i].remove();
+				}
+			} catch (e) {
+				dstImgs[i].remove();
+			}
+		}
+
+		// 2) 内联样式（近似）
+		inlineStyles(el, clone);
+
+		// 3) 交给 SVG foreignObject 渲染
+		const xml = new XMLSerializer().serializeToString(clone);
+		const svg =
+			'<svg xmlns="http://www.w3.org/2000/svg" width="' +
+			w +
+			'" height="' +
+			h +
+			'" viewBox="0 0 ' +
+			w0 +
+			' ' +
+			h0 +
+			'">' +
+			'<foreignObject x="0" y="0" width="100%" height="100%">' +
+			'<div xmlns="http://www.w3.org/1999/xhtml" style="width:' +
+			w0 +
+			'px;height:' +
+			h0 +
+			'px;">' +
+			xml +
+			'</div></foreignObject></svg>';
+
+		const svgUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
+		const img = await new Promise<HTMLImageElement>((resolve, reject) => {
+			const im = new Image();
+			im.onload = () => resolve(im);
+			im.onerror = () => reject(new Error('SVG 渲染失败'));
+			im.src = svgUrl;
+		});
+
+		const canvas = document.createElement('canvas');
+		canvas.width = w;
+		canvas.height = h;
+		const ctx = canvas.getContext('2d');
+		if (!ctx) return undefined;
+		ctx.fillStyle = '#ffffff';
+		ctx.fillRect(0, 0, w, h);
+		ctx.drawImage(img, 0, 0, w, h);
+
+		// 4) 跨域残留时此处会抛 SecurityError —— 由外层 try 捕获并返回 undefined
+		return canvas.toDataURL('image/png');
+	} catch (e) {
+		console.warn('[cxstudy M13] 截图失败，将按无截图降级：' + ((e as any)?.message || e));
+		return undefined;
+	}
+}
