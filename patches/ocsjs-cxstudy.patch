+/**
+ * [cxstudy M2] 单次运行内稳定不变的会话 ID。
+ *
+ * OpenCode Go 要求携带稳定的 x-opencode-session 头（每次会话一个 ID），
+ * 否则请求会被拒。上游不支持在 headers 里写动态值，故由本函数注入
+ * `${__session}` 占位符的值。
+ */
+let __cxSessionId: string | undefined;
+function getOrCreateSessionId(): string {
+	if (!__cxSessionId) {
+		__cxSessionId = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
+			const r = (Math.random() * 16) | 0;
+			return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
+		});
+	}
+	return __cxSessionId;
+}
