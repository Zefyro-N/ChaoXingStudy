+/**
+ * [cxstudy M7] 提交前人机验证检测。
+ *
+ * 只检测，不识别、不拖动、不重试。宁可误判跳过，也不误提交。
+ *
+ * 注：本函数**故意不包含通用的 `.slider` 选择器**。
+ * 实测超星课表组件（kb.chaoxing.com/res/pc/curriculum/schedule.html）也带 `.slider`，
+ * 该选择器会产生误报。
+ */
+function detectCaptcha(doc: Document): { hit: boolean; by: string } {
+	const topDoc: Document = (($gm.unsafeWindow as any).top?.document as Document) || doc;
+	const hints: [string, string][] = [
+		['img[src*="captcha"]', 'captcha 图片'],
+		['img[src*="validate"]', 'validate 图片'],
+		['#yzmImg, .yzmImg, .yzm, .picCode, .refresh-code', '图形验证码（超星常用类名）'],
+		['#verifyCode, #validateCode, #captcha', '验证码元素 id'],
+		['input[name="validateCode"], input[name="verifyCode"], input[name="captcha"]', '验证码输入框'],
+		['.verifyimg, .validateCode, .captcha', '验证码容器类名'],
+		['.geetest_panel, .nc-container, .verify-slider, .slide-verify, .nc_scale', '滑块验证组件']
+	];
+	for (const [sel, by] of hints) {
+		try {
+			if (doc.querySelector(sel)) return { hit: true, by: by + ' @frame' };
+		} catch (e) {
+			/* 跳域，忽略 */
+		}
+		try {
+			if (topDoc.querySelector(sel)) return { hit: true, by: by + ' @top' };
+		} catch (e) {
+			/* 跳域，忽略 */
+		}
+	}
+	try {
+		const txt = ((doc.body && doc.body.innerText) || '') + ' ' + ((topDoc.body && topDoc.body.innerText) || '');
+		for (const w of ['请输入验证码', '人机验证', '拖动滑块', '完成验证', '验证码校验']) {
+			if (txt.indexOf(w) >= 0) return { hit: true, by: '文案「' + w + '」' };
+		}
+	} catch (e) {
+		/* 忽略 */
+	}
+	return { hit: false, by: '' };
+}
+
+/** 供离线负向用例调用（P2 验收用），不参与正常流程 */
